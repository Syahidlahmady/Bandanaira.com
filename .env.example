# General
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=banda_neira_digital_secret_key_change_in_production_2026_secure
ALLOWED_ORIGINS=http://localhost:5175,http://localhost:5174,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5175,http://127.0.0.1:5174,http://127.0.0.1:5173

# Database (PostgreSQL + PostGIS)
POSTGRES_USER=postgres
