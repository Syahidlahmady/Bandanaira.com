# ==============================================================================
# Banda Digital Ecosystem - Environment Configuration Template
# ==============================================================================

# General
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL + PostGIS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=banda_digital
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/banda_digital
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/banda_digital

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Service
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Blockchain (Local EVM Testnet)
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_CHAIN_ID=1337
BLOCKCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
BLOCKCHAIN_DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
